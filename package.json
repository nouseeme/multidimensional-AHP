{
  "name": "ahp-topsis-decision-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176 --strictPort",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests index.html styles.css tsconfig.json package.json",
    "format:check": "prettier --check src tests index.html styles.css tsconfig.json package.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
